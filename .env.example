# Copy to `.env` (gitignored) next to docker-compose.yml.

# Postgres container credentials. The backend's DATABASE_URL is derived from these.
POSTGRES_DB=mujhackx
POSTGRES_USER=hackx
POSTGRES_PASSWORD=change-me

# Backend
JWT_SECRET=change-me

# Public URLs the browser uses to reach the API and WebSocket server.
# Baked into the frontend image at build time.
NEXT_PUBLIC_API_URL=https://dashboard.hackxmuj.com/api
NEXT_PUBLIC_WS_URL=wss://dashboard.hackxmuj.com
